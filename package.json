{
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.1"
  },
  "release": {
    "branches": [
      "dev-commitlint"
    ]
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,html,css,json}": [
      "yarn prettier --write"
    ]
  },
  "scripts": {
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  }
}