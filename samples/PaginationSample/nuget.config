<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Sample-local package cache, so every run picks up a freshly packed 0.0.0-local instead of a stale cached one. -->
    <add key="globalPackagesFolder" value="../.packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="../.localfeed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Miew.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
